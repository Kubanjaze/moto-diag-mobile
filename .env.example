# API_BASE_URL — moto-diag backend. Stubbed in Phase 186.
# Android emulator    → host: http://10.0.2.2:8000
# iOS simulator       → host: http://localhost:8000
# Physical iOS device → host: http://<dev-machine-LAN-IP>:8000
#                       (find via `ipconfig` on Windows or `ifconfig` on Mac;
#                        device + dev machine must be on same LAN, no AP isolation)
API_BASE_URL=http://10.0.2.2:8000
