# API_BASE_URL — the server the app uses until someone sets one in
# Settings → Server. Compiled in at build time: editing it needs a
# rebuild, not a Metro reload.
#
# A Release build fails unless this is an https:// address
# (scripts/check-release-env.js). Replace the placeholder with your
# server before archiving.
#
# For development, plain http is accepted for localhost, 127.0.0.1 and
# 10.0.2.2 only (src/api/serverUrl.ts, DEV_HTTP_HOSTS):
#   iOS simulator    → http://localhost:8000
#   Android emulator → http://10.0.2.2:8000
#   Physical device  → an https address the phone can reach, e.g. a
#                      `tailscale serve` URL; a LAN IP over http is refused
#
# Leave it empty in a Debug build and the app says "No server set — go
# to Settings."
API_BASE_URL=https://api.<your-domain>
