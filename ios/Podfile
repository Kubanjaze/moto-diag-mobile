# New Architecture is MANDATORY on React Native 0.85 and is not
# configurable here. `use_react_native!` force-sets
# RCT_NEW_ARCH_ENABLED=1 and RCT_FABRIC_ENABLED=1 unconditionally,
# and warns that passing 0 "is not supported anymore since React
# Native 0.82". This file used to set it to '0' anyway; the Pods
# generated by that very install carried -DRCT_NEW_ARCH_ENABLED=1,
# so the line disabled nothing and only misled whoever read it
# first. The project declares the truth in Info.plist
# (RCTNewArchEnabled=true). See docs/adr/002-*.md. (Phase 208)

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MotoDiag' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
